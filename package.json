{
  "name": "hearloop-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run typecheck test",
    "deploy:web": "turbo run deploy --filter=@hearloop/web",
    "deploy:docs": "turbo run deploy --filter=@hearloop/docs",
    "loop": "bun --filter @hearloop/web loop",
    "loop:live": "bun --filter @hearloop/web loop:live",
    "kane": "bun --cwd=apps/web run kane",
    "e2e:seed": "bun --filter @hearloop/web e2e:seed",
    "db:migrate": "bun --filter @hearloop/web db:migrate"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "turbo": "^2"
  }
}
