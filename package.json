{
  "name": "hearloop-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/docs",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "biome check . && turbo run typecheck test",
    "deploy:web": "turbo run deploy --filter=@hearloop/web",
    "deploy:docs": "turbo run deploy --filter=@hearloop/docs",
    "kane": "bun --cwd=apps/web run kane",
    "e2e:seed": "bun --filter @hearloop/web e2e:seed",
    "db:migrate": "bun --filter @hearloop/web db:migrate",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "turbo": "^2"
  }
}
