{
	"name": "hearloop-v2",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "vite build",
		"build": "vite build",
		"preview": "bun run build && vite preview",
		"deploy": "bun run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:migrate": "wrangler d1 migrations apply hearloop-v2 --local",
		"db:migrate:remote": "wrangler d1 migrations apply hearloop-v2 --remote",
		"loop": "bun scripts/loop.ts",
		"e2e:seed": "bun scripts/seed-e2e.ts",
		"kane": "bun scripts/kane.ts",
		"db:generate": "drizzle-kit generate"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@hookform/resolvers": "^7.0.7",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "^5.108.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "1.169.5",
		"better-auth": "^1.7.25",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.5.2",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.74.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.8.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-hook-form": "^7.92.0",
		"react-hotkeys-hook": "^5.4.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.26.0",
		"@tanstack/devtools-vite": "0.8.6",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.11",
