{
  "name": "hearloop",
  "version": "0.1.0",
  "description": "Build the top request on your hearloop board with any coding agent, verify it with Kane CLI, report back.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "hearloop": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target node --outfile dist/cli.js",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.2",
    "@hearloop/typescript-config": "workspace:*"
  }
}
